SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

# Redis/Celery - start Redis locally before running the worker or scheduler.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email reminders and reports (SMTP).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM_EMAIL=no-reply@example.com

# Optional Google Chat reminder webhook.
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/PLACEHOLDER/messages?key=PLACEHOLDER&token=PLACEHOLDER

# Daily reminder time in Asia/Kolkata (24-hour clock).
DAILY_REMINDER_HOUR=8
DAILY_REMINDER_MINUTE=0

# Monthly activity report schedule in Asia/Kolkata (24-hour clock).
# Defaults: day 1 of each month at 08:00.
MONTHLY_REPORT_DAY=1
MONTHLY_REPORT_HOUR=8
MONTHLY_REPORT_MINUTE=0
